{
  "name": "fizogezik",
  "version": "5.4.0",
  "private": true,
  "description": "Цифровая настольная игра для подготовки к ОГЭ по физике",
  "scripts": {
    "start": "node server.cjs",
    "dev": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "balance": "node tools/balance.cjs",
    "build:site": "python tools/build_site.py",
    "test:godot": "python tools/check_godot.py",
    "build:godot": "python tools/export_godot_web.py",
    "build": "python tools/export_godot_web.py && python tools/build_site.py",
    "test:webgl": "python tools/check_webgl.py",
    "test:network": "python tools/check_network_godot.py"
  },
  "engines": {"node": ">=20"},
  "repository": {"type": "git", "url": "https://github.com/Altersam/physogezic.git"},
  "homepage": "https://altersam.github.io/physogezic/"
}
